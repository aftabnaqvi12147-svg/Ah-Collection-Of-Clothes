// Simple Node.js + Express backend: products, cart, orders, newsletter signups.
// Data is stored in JSON files under /data (swap for a real database later if you want).

const express = require('express');
const path = require('path');
const fs = require('fs');
const { randomUUID } = require('crypto');
const cookieParser = require('cookie-parser');

const app = express();
const PORT = process.env.PORT || 3000;

const DATA_DIR = path.join(__dirname, 'data');
const PRODUCTS_FILE = path.join(DATA_DIR, 'products.json');
const ORDERS_FILE = path.join(DATA_DIR, 'orders.json');
const NEWSLETTER_FILE = path.join(DATA_DIR, 'newsletter.json');
const CARTS_FILE = path.join(DATA_DIR, 'carts.json');

function readJSON(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return fallback;
  }
}
function writeJSON(file, data) {
  fs.writeFileSync(file, JSON.stringify(data, null, 2));
}

// ---------- seed products if missing ----------
if (!fs.existsSync(PRODUCTS_FILE)) {
  writeJSON(PRODUCTS_FILE, [
    { id: 'AH-014', name: 'Oversized Hoodie — Concrete', price: 128, tag: 'New', stock: 24 },
    { id: 'AH-021', name: 'Cargo Utility Pants', price: 142, tag: null, stock: 18 },
    { id: 'AH-007', name: 'Boxy Tee — Off White', price: 54, tag: 'Restock', stock: 40 },
    { id: 'AH-030', name: 'Coach Bomber Jacket', price: 198, tag: null, stock: 10 },
    { id: 'AH-002', name: 'Structured Cap — Hazard', price: 42, tag: 'Low Stock', stock: 5 },
    { id: 'AH-018', name: 'Quarter-Zip Fleece', price: 118, tag: null, stock: 15 }
  ]);
}
if (!fs.existsSync(ORDERS_FILE)) writeJSON(ORDERS_FILE, []);
if (!fs.existsSync(NEWSLETTER_FILE)) writeJSON(NEWSLETTER_FILE, []);
if (!fs.existsSync(CARTS_FILE)) writeJSON(CARTS_FILE, {});

app.use(express.json());
app.use(cookieParser());
app.use(express.static(path.join(__dirname, 'public')));

// ---------- cart identity via cookie ----------
app.use((req, res, next) => {
  let cartId = req.cookies.cart_id;
  if (!cartId) {
    cartId = randomUUID();
    res.cookie('cart_id', cartId, { httpOnly: true, maxAge: 30 * 24 * 60 * 60 * 1000 });
  }
  req.cartId = cartId;
  next();
});

// ---------- PRODUCTS ----------
app.get('/api/products', (req, res) => {
  res.json(readJSON(PRODUCTS_FILE, []));
});

// ---------- CART ----------
app.get('/api/cart', (req, res) => {
  const carts = readJSON(CARTS_FILE, {});
  const cart = carts[req.cartId] || [];
  const products = readJSON(PRODUCTS_FILE, []);
  const items = cart.map(line => {
    const p = products.find(p => p.id === line.id);
    return p ? { ...p, qty: line.qty } : null;
  }).filter(Boolean);
  const total = items.reduce((sum, i) => sum + i.price * i.qty, 0);
  res.json({ items, total: Number(total.toFixed(2)) });
});

app.post('/api/cart/add', (req, res) => {
  const { id, qty } = req.body;
  const quantity = Math.max(1, parseInt(qty) || 1);
  const products = readJSON(PRODUCTS_FILE, []);
  const product = products.find(p => p.id === id);
  if (!product) return res.status(404).json({ error: 'Product not found' });

  const carts = readJSON(CARTS_FILE, {});
  const cart = carts[req.cartId] || [];
  const existing = cart.find(line => line.id === id);
  if (existing) existing.qty += quantity;
  else cart.push({ id, qty: quantity });
  carts[req.cartId] = cart;
  writeJSON(CARTS_FILE, carts);
  res.json({ ok: true });
});

app.post('/api/cart/remove', (req, res) => {
  const { id } = req.body;
  const carts = readJSON(CARTS_FILE, {});
  carts[req.cartId] = (carts[req.cartId] || []).filter(line => line.id !== id);
  writeJSON(CARTS_FILE, carts);
  res.json({ ok: true });
});

// ---------- CHECKOUT (stub — wire up Stripe/PayPal here later) ----------
app.post('/api/checkout', (req, res) => {
  const { email, name, address } = req.body;
  if (!email || !name || !address) {
    return res.status(400).json({ error: 'Name, email, and address are required.' });
  }
  const carts = readJSON(CARTS_FILE, {});
  const cart = carts[req.cartId] || [];
  if (cart.length === 0) return res.status(400).json({ error: 'Cart is empty.' });

  const products = readJSON(PRODUCTS_FILE, []);
  const items = cart.map(line => {
    const p = products.find(p => p.id === line.id);
    return { id: line.id, name: p?.name, price: p?.price, qty: line.qty };
  });
  const total = items.reduce((sum, i) => sum + (i.price || 0) * i.qty, 0);

  const order = {
    orderId: randomUUID(),
    email, name, address,
    items, total: Number(total.toFixed(2)),
    status: 'pending_payment', // no real payment processor is wired up yet
    createdAt: new Date().toISOString()
  };

  const orders = readJSON(ORDERS_FILE, []);
  orders.push(order);
  writeJSON(ORDERS_FILE, orders);

  // clear cart
  carts[req.cartId] = [];
  writeJSON(CARTS_FILE, carts);

  res.json({ ok: true, orderId: order.orderId, total: order.total });
});

// ---------- NEWSLETTER ----------
app.post('/api/newsletter', (req, res) => {
  const { email } = req.body;
  if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
    return res.status(400).json({ error: 'Valid email required.' });
  }
  const list = readJSON(NEWSLETTER_FILE, []);
  if (!list.includes(email)) {
    list.push(email);
    writeJSON(NEWSLETTER_FILE, list);
  }
  res.json({ ok: true });
});

app.listen(PORT, () => {
  console.log(AH Collection server running at http://localhost:${PORT});
});
